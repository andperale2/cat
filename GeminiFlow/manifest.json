{
  "manifest_version": 3,
  "name": "GeminiFlow",
  "version": "1.0",
  "description": "Automated prompt sequences and image rendering for Gemini.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "vendor/jszip.min.js",
        "storage/db.js",
        "dom_actions.js",
        "ui.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Open GeminiFlow"
  }
}
